APP_NAME=Smart Semantic Web TV Backend
API_PREFIX=/api
DATABASE_URL=postgresql+psycopg://app_user:change_me@localhost:5432/smart_semantic_web_tv
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5500
YOUTUBE_API_KEY=replace-with-youtube-data-api-key
GEMINI_API_KEY=replace-with-gemini-api-key
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSIONS=768
GEMINI_VIEWING_PLANNER_MODEL=gemini-3.6-flash
GEMINI_ASSISTANT_MODEL=gemini-3.6-flash
TMDB_API_KEY=replace-with-tmdb-api-key-if-you-use-v3-query-auth
TMDB_ACCESS_TOKEN=replace-with-tmdb-read-access-token-if-you-use-bearer-auth
TMDB_LANGUAGE=en-US
TMDB_REGION=US
JWT_SECRET_KEY=replace-with-a-long-random-secret-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
LIVE_TV_AUTO_SYNC=true
LIVE_TV_STATUS_TTL_MINUTES=10
LIVE_TV_EPG_TTL_MINUTES=360
LIVE_TV_DEFAULT_EPG_WINDOW_HOURS=4
LIVE_TV_REQUEST_TIMEOUT_SECONDS=12
CATALOG_AUTO_SYNC=true
CATALOG_SYNC_TTL_MINUTES=1440
CATALOG_SYNC_TARGET_ITEMS=160
CATALOG_REQUEST_TIMEOUT_SECONDS=12
PLAYBACK_CATALOG_AUTO_SYNC=true
PLAYBACK_HEALTH_CHECKS_ENABLED=true
PLAYBACK_HEALTH_TTL_MINUTES=180
PLAYBACK_REQUEST_TIMEOUT_SECONDS=10
SEARCH_INDEX_AUTO_SYNC=true
SEARCH_INDEX_EPG_WINDOW_HOURS=48
SEARCH_REQUEST_TIMEOUT_SECONDS=12
RECOMMENDATION_DEFAULT_WINDOW_HOURS=12
VIEWING_PLANNER_CANDIDATE_LIMIT=18
VIEWING_PLANNER_MAX_ITEMS=6
WATCH_PARTY_HOST_RECONNECT_GRACE_SECONDS=30
WATCH_PARTY_CHAT_HISTORY_LIMIT=40
WATCH_PARTY_CHAT_MESSAGE_MAX_LENGTH=400
WATCH_PARTY_DRIFT_THRESHOLD_SECONDS=1.5
WATCH_PARTY_SYNC_REQUEST_INTERVAL_SECONDS=12
